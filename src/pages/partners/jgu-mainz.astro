---
import Layout from '~/layouts/PageLayout.astro';
import { getAsset, getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'JGU Mainz team — FIMI-RESIST',
  description: 'Meet the FIMI-RESIST coordination team at Johannes Gutenberg University Mainz.',
  ignoreTitleTemplate: true,
};

const people = [
  {
    name: 'Prof. Dr. Vera Schmitt',
    role: 'Coordinator',
    image: '/vera-schmitt.webp',
    alt: 'Portrait of Prof. Dr. Vera Schmitt',
    paragraphs: [
      'Prof. Dr. Vera Schmitt is Professor of Information Systems at Johannes Gutenberg University Mainz, where her research focuses on explainable and robust AI and its applications in socially relevant domains. She combines methods from Natural Language Processing and Explainable AI, with research spanning medical decision support, disinformation detection, deepfakes, and information manipulation.',
      'She is the founder and head of the XplaiNLP research group and has secured approximately €6 million in third-party funding as Principal Investigator, leading several national and European research projects. Previously, she worked at TU Berlin’s Quality and Usability Lab and as a guest researcher at the German Research Center for Artificial Intelligence (DFKI). Her work has received multiple Best Paper Awards, and in 2025, Der Tagesspiegel named her among the “100 most important minds in Berlin science.”',
    ],
  },
  {
    name: 'Dr. Veronika Solopova',
    role: 'Project Manager',
    image: '/veronika-solopova.webp',
    alt: 'Portrait of Dr. Veronika Solopova',
    paragraphs: [
      'Dr. Veronika Solopova is a Senior Researcher at Johannes Gutenberg University Mainz and TU Berlin and co-lead of the XplaiNLP research group. Her research focuses on natural language processing and multimodal AI for social media analysis, with particular emphasis on disinformation, propaganda, harmful content, explainable AI, and human-centered content moderation.',
      'She received her doctorate in Computer Science from Freie Universität Berlin with summa cum laude for her work on hybrid AI systems for automated content moderation and analysis. Her doctoral research received the German Public Broadcasters’ ARD/ZDF Award “Women + Media Technology” (Frauen + Medientechnologie).',
      'Veronika is a Junior Fellow of the German Informatics Society (Gesellschaft für Informatik, GI) and has contributed to several national and European research projects on AI, disinformation, and fact-checking. Her work combines NLP, multimodal learning, and explainable AI to better understand and address complex information phenomena on the Web and social media.',
    ],
  },
  {
    name: 'Ariana Sahitaj',
    role: 'Researcher',
    image: '/ariana-sahitaj.webp',
    alt: 'Portrait of Ariana Sahitaj',
    paragraphs: [
      'Ariana Sahitaj holds a Bachelor’s degree in Business Information Systems from the University of Trier and a Master’s degree with honours in Information Systems Management from the Technical University of Berlin. Since her undergraduate studies, she has gained research experience across multiple institutions, including the University of Trier, the German Research Center for Artificial Intelligence (DFKI), and the Quality and Usability Lab (QUL) at the Technical University of Berlin.',
      'Her background spans Natural Language Processing, Large Language Models, argument analysis, and disinformation detection. In 2025, she received the Women Informatics Thesis Award from the German Informatics Society (Gesellschaft für Informatik). In 2026, she was awarded the female upgreat scholarship by the Bechtle Foundation.',
    ],
  },
];
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>
  <section class="team-hero">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <a class="back-link" href={getPermalink('/#partners')}>← Back to the consortium</a>
      <div class="hero-grid">
        <div>
          <p class="eyebrow">Coordinator</p>
          <h1>Johannes Gutenberg University Mainz</h1>
          <p class="intro">
            The JGU Mainz team coordinates FIMI-RESIST and brings expertise in explainable AI, natural language
            processing, multimodal analysis and research management.
          </p>
        </div>
        <a class="jgu-mark" href="https://www.uni-mainz.de/" aria-label="Visit Johannes Gutenberg University Mainz">
          <img src={getAsset('/jgu-mainz-logo.png')} alt="Johannes Gutenberg University Mainz" />
          <span>Visit JGU Mainz ↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="team-section">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <p class="eyebrow">Coordination team</p>
      <div class="people">
        {
          people.map((person) => (
            <article class="person">
              <div class="portrait-wrap">
                <img src={getAsset(person.image)} alt={person.alt} width="720" height="720" loading="lazy" />
              </div>
              <div class="bio">
                <p class="role">{person.role}</p>
                <h2>{person.name}</h2>
                {person.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .team-hero {
    padding: 5rem 0 6rem;
    background: linear-gradient(135deg, #f8fafc 0%, #edf3fb 62%, #fff9e6 100%);
  }
  .back-link {
    color: #475569;
    font-weight: 750;
    text-decoration: none;
  }
  .back-link:hover {
    color: #042351;
  }
  .hero-grid {
    display: grid;
    gap: 3rem;
    align-items: end;
    margin-top: 4rem;
  }
  .eyebrow {
    color: #042351;
    font-size: 0.74rem;
    font-weight: 850;
    letter-spacing: 0.2em;
    line-height: 1;
    text-transform: uppercase;
  }
  h1 {
    max-width: 60rem;
    margin-top: 1.2rem;
    font-size: clamp(3rem, 7vw, 6.8rem);
    font-weight: 900;
    letter-spacing: -0.055em;
    line-height: 0.95;
  }
  .intro {
    max-width: 48rem;
    margin-top: 2rem;
    color: #475569;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.65;
  }
  .jgu-mark {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    width: min(100%, 18rem);
    padding: 2rem;
    border: 1px solid #e2e8f0;
    border-radius: 1.5rem;
    background: white;
    color: #042351;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
  }
  .jgu-mark img {
    width: 9rem;
    height: 9rem;
    object-fit: contain;
  }
  .team-section {
    padding: 7rem 0;
  }
  .people {
    margin-top: 3.5rem;
  }
  .person {
    display: grid;
    gap: 2.5rem;
    padding: 3.5rem 0;
    border-top: 1px solid #cbd5e1;
  }
  .portrait-wrap img {
    width: min(100%, 24rem);
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    background: #eef2f7;
  }
  .role {
    color: #042351 !important;
    font-size: 0.76rem !important;
    font-weight: 850;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .bio h2 {
    margin-top: 0.55rem;
    font-size: clamp(2.2rem, 4vw, 4rem);
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .bio p {
    max-width: 52rem;
    margin-top: 1.3rem;
    color: #475569;
    font-size: 1.08rem;
    line-height: 1.75;
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr auto;
    }
    .person {
      grid-template-columns: 22rem 1fr;
      gap: 5rem;
    }
  }
  @media (max-width: 640px) {
    .team-hero {
      padding: 3.5rem 0 4rem;
    }
    .hero-grid {
      margin-top: 2.5rem;
    }
    .team-section {
      padding: 4.5rem 0;
    }
    .person {
      padding: 2.75rem 0;
    }
  }
</style>
