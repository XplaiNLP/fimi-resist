---
import Layout from '~/layouts/PageLayout.astro';
import { SITE, I18N } from 'astrowind:config';
import StructuredData from '~/components/common/StructuredData.astro';
import { getAsset } from '~/utils/permalinks';
const metadata = {
  title: 'FIMI-RESIST — Building European resilience against information manipulation',
  description:
    "FIMI-RESIST connects research, policy and practice to strengthen Europe's response to disinformation and foreign information manipulation and interference.",
  ignoreTitleTemplate: true,
};
const objectives = [
  [
    '01',
    'Advisory support',
    'Turn European research into practical, tailored guidance for policymakers, practitioners and civil society.',
  ],
  [
    '02',
    'Tools that work',
    'Systematically assess existing counter-FIMI tools, with usability and interoperability at the centre.',
  ],
  [
    '03',
    'Capacity building',
    'Co-design training, workshops and toolkits for media, educators, NGOs, fact-checkers and communities.',
  ],
  [
    '04',
    'Connected frameworks',
    'Bridge established approaches into a living meta-framework with a shared language for action.',
  ],
  [
    '05',
    'Evidence for policy',
    'Translate findings on AI and big data into rights-respecting, operational policy recommendations.',
  ],
  [
    '06',
    'A durable network',
    'Connect research, policy, industry and civil society in a European ecosystem that lasts beyond the project.',
  ],
];
const partners = [
  ['JGU Mainz', 'Germany · Coordinator'],
  ['KInIT', 'Slovakia'],
  ['CERTH', 'Greece'],
  ['University of Amsterdam', 'Netherlands'],
  ['Logically / INSIKT', 'United Kingdom / Spain'],
  ['Exorde Labs', 'France'],
  ['Cyfluence Research Center', 'Germany'],
  ['Deutsche Welle', 'Germany'],
  ['VoxUkraine', 'Ukraine'],
  ['Factiverse', 'Norway'],
  ['Gretchen AI', 'Germany · Associated partner'],
];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ResearchProject',
    name: SITE?.name,
    url: SITE?.site,
    description: metadata.description,
    inLanguage: I18N?.language,
    funder: { '@type': 'Organization', name: 'European Union' },
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={schema} />
  <Fragment slot="announcement"></Fragment>
  <section class="hero relative overflow-hidden pt-20 pb-16 lg:pt-32 lg:pb-24">
    <div class="signal signal-a"></div><div class="signal signal-b"></div><div
      class="mx-auto max-w-7xl px-5 sm:px-8 relative"
    >
      <div class="grid lg:grid-cols-[1.2fr_.8fr] gap-14 items-center">
        <div>
          <p class="eyebrow">Horizon Europe · Grant 101285890</p><h1
            class="mt-6 max-w-5xl text-5xl sm:text-6xl lg:text-8xl font-black tracking-[-0.055em] leading-[.94]"
          >
            Resilience starts<br />with <span class="marker">connection.</span>
          </h1><p class="mt-8 max-w-2xl text-xl sm:text-2xl leading-relaxed text-slate-700">
            FIMI-RESIST turns fragmented knowledge into practical European safeguards against disinformation and foreign
            information manipulation.
          </p><div class="mt-10 flex flex-wrap gap-4">
            <a class="button-primary" href="#mission">Explore the mission <span aria-hidden="true">↘</span></a><a
              class="button-secondary"
              href="#partners">Meet the consortium</a
            >
          </div>
        </div>
        <div class="hero-card" aria-label="Project at a glance">
          <img src={getAsset('/fimi-resist-logo.png')} alt="FIMI-RESIST" class="w-full h-auto" /><dl
            class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-2xl bg-slate-200"
          >
            <div><dt>Duration</dt><dd>30 months</dd></div><div><dt>Starts</dt><dd>Sep 2026</dd></div><div>
              <dt>Countries</dt><dd>9</dd>
            </div><div><dt>EU grant</dt><dd>€3.5M</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>
  <section id="mission" class="section bg-ink text-white scroll-mt-20">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 grid lg:grid-cols-[.72fr_1.28fr] gap-12 lg:gap-24">
      <div><p class="eyebrow text-yellow-300">Why FIMI-RESIST</p><p class="section-index">01 / Mission</p></div><div>
        <h2 class="display">From scattered efforts to a shared European response.</h2><p class="lead-light">
          Powerful tools and research already exist. Too often, they remain hard to find, difficult to use or
          disconnected from the people who need them. Meanwhile, AI-enabled manipulation is evolving fast.
        </p><p class="lead-light">
          We connect the pieces — evaluating tools, building skills, aligning frameworks and creating trusted channels
          between researchers, practitioners, policymakers and civil society.
        </p>
      </div>
    </div>
  </section>
  <section id="work" class="section scroll-mt-20">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="max-w-3xl">
        <p class="eyebrow">What we do</p><h2 class="display mt-5">Six routes to stronger information resilience.</h2>
      </div><div class="mt-14 grid md:grid-cols-2 lg:grid-cols-3 border-l border-t border-slate-300">
        {
          objectives.map(([number, title, text]) => (
            <article class="objective">
              <>
                <span>{number}</span>
                <h3>{title}</h3>
                <p>{text}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section id="partners" class="section bg-soft scroll-mt-20">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="grid lg:grid-cols-[.8fr_1.2fr] gap-12 lg:gap-24">
        <div>
          <p class="eyebrow">The consortium</p><h2 class="display mt-5">One challenge.<br />Many perspectives.</h2><p
            class="mt-7 text-lg text-slate-600"
          >
            Research, media, civil society and technology partners across Europe — with frontline experience and deep
            links to EDMO hubs and related initiatives.
          </p>
        </div><div class="partner-grid">
          {
            partners.map(([name, location]) => (
              <div class="partner-card">
                <>
                  <div class="logo-placeholder" aria-hidden="true">
                    Logo
                  </div>
                  <div>
                    <>
                      <h3>{name}</h3>
                      <p>{location}</p>
                    </>
                  </div>
                </>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
  <section id="resources" class="section scroll-mt-20">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <p class="eyebrow">Knowledge in action</p><div class="mt-5 grid lg:grid-cols-2 gap-10 items-end">
        <h2 class="display">Resources will grow with the project.</h2><p class="text-xl text-slate-600">
          This will become the home for tested tools, advisory material, training resources, policy briefs, events and
          open project outputs.
        </p>
      </div><div class="mt-14 grid md:grid-cols-3 gap-5">
        <div class="resource-card">
          <span>01</span><h3>Tools & frameworks</h3><p>
            Comparative assessments, usability findings and the evolving meta-framework.
          </p><small>Available from M6</small>
        </div><div class="resource-card">
          <span>02</span><h3>Training & events</h3><p>
            Practical learning opportunities and materials tailored to different sectors.
          </p><small>Programme coming soon</small>
        </div><div class="resource-card">
          <span>03</span><h3>Policy & publications</h3><p>
            Evidence-based briefs, reports and open research outputs.
          </p><small>Updates from 2027</small>
        </div>
      </div>
    </div>
  </section>
  <section id="updates" class="section pt-0 scroll-mt-20">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="updates">
        <div>
          <p class="eyebrow text-yellow-300">Follow the work</p><h2
            class="text-4xl sm:text-6xl font-black tracking-tight mt-4"
          >
            Project updates begin soon.
          </h2>
        </div><p class="max-w-lg text-lg text-slate-300">
          FIMI-RESIST starts in September 2026. News, events and opportunities to participate will be published here as
          the project gets underway.
        </p>
      </div>
    </div>
  </section>
</Layout>
<style>
  .hero {
    background: linear-gradient(135deg, #f8fafc 0%, #eef2ff 55%, #fffce8 100%);
  }
  .signal {
    position: absolute;
    border: 2px solid #2634ff;
    border-radius: 999px;
    opacity: 0.18;
  }
  .signal-a {
    width: 36rem;
    height: 36rem;
    right: -10rem;
    top: -15rem;
  }
  .signal-b {
    width: 17rem;
    height: 17rem;
    right: 18rem;
    bottom: -10rem;
    border-color: #f5d90a;
  }
  .eyebrow {
    font-size: 0.74rem;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-weight: 800;
    color: #2634ff;
  }
  .marker {
    position: relative;
    z-index: 0;
  }
  .marker:after {
    content: '';
    position: absolute;
    left: 0;
    right: -0.05em;
    height: 0.18em;
    bottom: 0.04em;
    background: #f5d90a;
    z-index: -1;
    transform: rotate(-1deg);
  }
  .button-primary,
  .button-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    border-radius: 999px;
    padding: 0.9rem 1.35rem;
    font-weight: 800;
    transition: 0.2s;
  }
  .button-primary {
    background: #2634ff;
    color: white;
  }
  .button-primary:hover {
    background: #101bbb;
    transform: translateY(-2px);
  }
  .button-secondary {
    border: 1px solid #94a3b8;
  }
  .button-secondary:hover {
    border-color: #2634ff;
    color: #2634ff;
  }
  .hero-card {
    background: rgba(255, 255, 255, 0.76);
    padding: 2rem;
    border: 1px solid rgba(148, 163, 184, 0.35);
    border-radius: 2rem;
    box-shadow: 0 30px 80px rgba(15, 23, 42, 0.12);
    backdrop-filter: blur(14px);
  }
  .hero-card dl > div {
    background: white;
    padding: 1rem;
  }
  .hero-card dt {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.65rem;
    color: #64748b;
    font-weight: 700;
  }
  .hero-card dd {
    font-weight: 850;
    font-size: 1.15rem;
    margin-top: 0.2rem;
  }
  .section {
    padding: 6rem 0;
  }
  .bg-ink {
    background: #07101f;
  }
  .bg-soft {
    background: #f3f5f9;
  }
  .section-index {
    margin-top: 1rem;
    color: #94a3b8;
    font-size: 0.85rem;
  }
  .display {
    font-size: clamp(2.5rem, 5vw, 4.9rem);
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 1.01;
  }
  .lead-light {
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    line-height: 1.7;
    color: #cbd5e1;
    margin-top: 2rem;
    max-width: 52rem;
  }
  .objective {
    padding: 2rem;
    border-right: 1px solid;
    border-bottom: 1px solid;
    border-color: #cbd5e1;
    min-height: 17rem;
  }
  .objective > span {
    font-size: 0.72rem;
    font-weight: 900;
    color: #2634ff;
  }
  .objective h3 {
    font-size: 1.45rem;
    font-weight: 850;
    margin-top: 2.6rem;
  }
  .objective p {
    color: #64748b;
    line-height: 1.65;
    margin-top: 0.8rem;
  }
  .partner-grid {
    display: grid;
    gap: 0.75rem;
  }
  .partner-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
  }
  .logo-placeholder {
    width: 4.5rem;
    height: 3.25rem;
    border: 1px dashed #94a3b8;
    border-radius: 0.6rem;
    display: grid;
    place-items: center;
    color: #94a3b8;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    flex: none;
  }
  .partner-card h3 {
    font-weight: 800;
  }
  .partner-card p {
    font-size: 0.83rem;
    color: #64748b;
  }
  .resource-card {
    padding: 2rem;
    border-radius: 1.4rem;
    border: 1px solid #e2e8f0;
    background: white;
  }
  .resource-card > span {
    color: #2634ff;
    font-size: 0.72rem;
    font-weight: 900;
  }
  .resource-card h3 {
    font-size: 1.5rem;
    font-weight: 850;
    margin-top: 2.2rem;
  }
  .resource-card p {
    color: #64748b;
    line-height: 1.65;
    margin-top: 0.7rem;
  }
  .resource-card small {
    display: block;
    border-top: 1px solid #e2e8f0;
    margin-top: 2rem;
    padding-top: 1rem;
    color: #475569;
    font-weight: 700;
  }
  .updates {
    background: #07101f;
    color: white;
    border-radius: 2rem;
    padding: clamp(2rem, 6vw, 5rem);
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 900px) {
    .updates {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: end;
    }
  }
  @media (max-width: 640px) {
    .section {
      padding: 4.5rem 0;
    }
    .hero-card {
      padding: 1.25rem;
    }
    .objective {
      min-height: auto;
    }
    .partner-card {
      padding: 0.8rem;
    }
  }
</style>
