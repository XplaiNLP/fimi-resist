---
import Layout from '~/layouts/PageLayout.astro';
import { getAsset, getPermalink } from '~/utils/permalinks';

interface Person {
  name: string;
  image: string;
  imageCredit?: string;
  bio?: string[];
  links?: { label: string; href: string }[];
}

interface Props {
  name: string;
  shortName: string;
  country: string;
  logo: string;
  logoBackdrop?: 'light' | 'dark';
  intro: string;
  people?: Person[];
}

const { name, shortName, country, logo, logoBackdrop = 'light', intro, people = [] } = Astro.props;
const metadata = {
  title: `${shortName} team — FIMI-RESIST`,
  description: `Meet the FIMI-RESIST team at ${name}.`,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>
  <section class="partner-hero">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <a class="back-link" href={getPermalink('/#partners')}>← Back to the consortium</a>
      <div class="hero-grid">
        <div>
          <p class="eyebrow">Consortium partner · {country}</p>
          <h1>{name}</h1>
          <p class="intro">{intro}</p>
        </div>
        <div class:list={['logo-panel', `logo-${logoBackdrop}`]}>
          <img src={getAsset(logo)} alt={`${name} logo`} />
        </div>
      </div>
    </div>
  </section>

  <section class="team-section">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <p class="eyebrow">FIMI-RESIST team</p>
      {
        people.length ? (
          <div class="people">
            {people.map((person) => (
              <article class="person">
                <div class="person-media">
                  <img
                    src={getAsset(person.image)}
                    alt={`Portrait of ${person.name}`}
                    width="720"
                    height="720"
                    loading="lazy"
                  />
                  {person.imageCredit && <p class="image-credit">{person.imageCredit}</p>}
                </div>
                <div class="bio">
                  <h2>{person.name}</h2>
                  {person.bio?.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                  {person.links?.length && (
                    <div class="profile-links">
                      {person.links.map((link) => (
                        <a href={link.href} target="_blank" rel="noopener noreferrer">
                          {link.label} ↗
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="team-pending">
            <h2>Team information coming soon.</h2>
            <p>This page will be updated as additional partner information becomes available.</p>
          </div>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .partner-hero {
    padding: 5rem 0 6rem;
    background: linear-gradient(135deg, #f8fafc 0%, #edf3fb 62%, #fff9e6 100%);
  }
  .back-link {
    color: #475569;
    font-weight: 750;
    text-decoration: none;
  }
  .back-link:hover {
    color: #042351;
  }
  .hero-grid {
    display: grid;
    gap: 3rem;
    align-items: end;
    margin-top: 4rem;
  }
  .eyebrow {
    color: #042351;
    font-size: 0.74rem;
    font-weight: 850;
    letter-spacing: 0.2em;
    line-height: 1;
    text-transform: uppercase;
  }
  h1 {
    max-width: 62rem;
    margin-top: 1.2rem;
    font-size: clamp(3rem, 7vw, 6.8rem);
    font-weight: 900;
    letter-spacing: -0.055em;
    line-height: 0.95;
  }
  .intro {
    max-width: 48rem;
    margin-top: 2rem;
    color: #475569;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.65;
  }
  .logo-panel {
    display: grid;
    place-items: center;
    width: min(100%, 22rem);
    min-height: 15rem;
    padding: 2.25rem;
    border: 1px solid #e2e8f0;
    border-radius: 1.5rem;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
  }
  .logo-light {
    background: white;
  }
  .logo-dark {
    background: #080b13;
  }
  .logo-panel img {
    width: 100%;
    max-height: 10rem;
    object-fit: contain;
  }
  .team-section {
    padding: 7rem 0;
  }
  .people {
    display: grid;
    gap: 1rem;
    margin-top: 3.5rem;
  }
  .person {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border: 1px solid #e2e8f0;
    border-radius: 1.5rem;
    background: white;
  }
  .person-media > img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: #eef2f7;
  }
  .image-credit {
    padding: 0.6rem 1rem;
    color: #64748b;
    font-size: 0.7rem;
    line-height: 1.45;
  }
  .bio {
    padding: 1.5rem;
  }
  .bio h2 {
    font-size: 1.45rem;
    font-weight: 850;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .bio p {
    margin-top: 1rem;
    color: #475569;
    line-height: 1.65;
  }
  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.5rem;
  }
  .profile-links a {
    padding: 0.6rem 0.85rem;
    border-radius: 999px;
    background: #eaf1fa;
    color: #042351;
    font-size: 0.82rem;
    font-weight: 800;
    text-decoration: none;
  }
  .profile-links a:hover {
    background: #dbe7f5;
  }
  .team-pending {
    margin-top: 3.5rem;
    padding: clamp(2rem, 5vw, 4rem);
    border-radius: 1.5rem;
    background: #f3f5f9;
  }
  .team-pending h2 {
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 900;
    letter-spacing: -0.04em;
  }
  .team-pending p {
    margin-top: 1rem;
    color: #64748b;
    font-size: 1.1rem;
  }
  @media (min-width: 700px) {
    .people {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1050px) {
    .hero-grid {
      grid-template-columns: 1fr auto;
    }
    .people {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .partner-hero {
      padding: 3.5rem 0 4rem;
    }
    .hero-grid {
      margin-top: 2.5rem;
    }
    .team-section {
      padding: 4.5rem 0;
    }
  }
</style>
